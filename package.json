{
  "name": "pdf-character-sheet",
  "version": "3.0.0",
  "private": true,
  "description": "Form-fillable PDFs as character sheets for Foundry VTT",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Fabricio Cavalcante",
  "scripts": {
    "build": "vttforge build",
    "dev": "vttforge dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs",
    "e2e:up": "node -e \"import('./e2e/scripts/foundry.mjs').then(m => m.start()).then(r => console.log(r.baseUrl))\"",
    "e2e:down": "node -e \"import('./e2e/scripts/foundry.mjs').then(m => m.stop())\""
  },
  "dependencies": {
    "@vttforge/core": "^0.17.0",
    "@vttforge/styles": "^0.5.0",
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vttforge/cli": "^0.15.3",
    "@vttforge/testing": "^0.5.1",
    "@vttforge/vite-plugin": "^0.5.3",
    "happy-dom": "^20.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.25.0"
}
