{
  "id": "pdf-character-sheet",
  "type": "module",
  "title": "PDF Character Sheet",
  "description": "Form-fillable PDFs as character sheets for Foundry VTT.",
  "version": "3.0.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Fabricio Cavalcante"
    }
  ],
  "esmodules": [
    "main.mjs"
  ],
  "styles": [
    {
      "src": "styles/main.css"
    },
    {
      "src": "styles/themes.css"
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "json",
        "hbs"
      ],
      "paths": [
        "styles",
        "lang",
        "templates"
      ]
    }
  },
  "documentTypes": {
    "Item": {
      "pdf": {
        "htmlFields": [],
        "filePathFields": {
          "url": [
            "TEXT"
          ]
        }
      }
    }
  },
  "socket": true
}
